# ==============================================================================
# Required API Keys
# ==============================================================================
# Get your Groq API Key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your Jina AI API Key from: https://jina.ai/embeddings
JINA_API_KEY=your_jina_ai_api_key_here

# ==============================================================================
# Optional Configurations (Defaults will be used if omitted)
# ==============================================================================
GROQ_MODEL=openai/gpt-oss-120b
JINA_MODEL=jina-embeddings-v3
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_documents
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
